  online
  block
  present
  AP1 AP2 AP3 AP4 AP5
  AN1 AN2 AN3 AN4 AN5
  S1 S2 S3 S4 S5
  pblock;

  CLUSTER = ID;

  GROUPING = V15 (1 = t1 2 = t2 3 = t3 4 = t4);
  ! V15=1: <15 min.
  ! V15=2: >15 y <=30 min.
  ! V15=3: >30 y <=60 min.
  ! V15=4: >60 min.

  MISSING = ALL(-999);

  DEFINE:
  ! Survey method: online=1, face-to-face=2.
  pblock = present*block;

  ANALYSIS:
  TYPE = COMPLEX;
  ESTIMATOR = MLR;
  STARTS = 0;
  ITERATIONS = 10000;

  MODEL:

  ! Reference group = category 1.
  AP BY
  AP1@1
  AP2*0.605 (lpa2)
  AP3*0.874 (lpa3)
  AP4*0.922 (lpa4)
  AP5*0.8 (lpa5);

  AN BY
  AN1@1
  AN2*0.797 (lna2)
  AN3*1.134 (lna3)
  AN4*1.116 (lna4)
