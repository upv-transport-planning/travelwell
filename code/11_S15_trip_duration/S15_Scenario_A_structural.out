  S2*1.061 (lst2)
  S3*1.061 (lst3)
  S4*0.7 (lst4)
  S5*1.03 (lst5);

  ! Cross-loadings kept free across groups.
  AN BY AP2 (t1xpa);
  AP BY AN2 (t1xan);

  ! Item intercepts free: scalar invariance is not imposed.
  [AP1-AP5*];
  [AN1-AN5*];
  [S1-S5*];

