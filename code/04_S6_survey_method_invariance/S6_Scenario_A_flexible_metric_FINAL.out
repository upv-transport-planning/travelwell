Mplus VERSION 9.1
MUTHEN & MUTHEN
08/17/2026  11:22 AM

INPUT INSTRUCTIONS

  TITLE:
    S6 - SURVEY-METHOD FLEXIBLE METRIC INVARIANCE - SCENARIO A
    SOCIAL STREET ACTIVATION
    v6: within-participant GROUPMEAN centering; Mplus BY syntax corrected.
    Twelve primary non-reference loadings constrained equal across survey methods;
    retained cross-loadings remain free.

  DATA:
    FILE = ../data/Scenario_A_long_final.txt;

  VARIABLE:
    NAMES =
    ID MODO_rango online block present
    AP1 AP2 AP3 AP4 AP5
    AN1 AN2 AN3 AN4 AN5
    S1 S2 S3 S4 S5
    V1 V2 V3 V4 V5 V6 V7 V8 V9 V10
    V11 V12 V13 V14 V15 V16 V17 V18 V19;
    USEVARIABLES =
    ID AP1 AP2 AP3 AP4 AP5
    AN1 AN2 AN3 AN4 AN5
    S1 S2 S3 S4 S5;
    CLUSTER = ID;
    GROUPING = online (1 = online 2 = f2f);
    MISSING = ALL(-999);

  DEFINE:
    CENTER AP1 AP2 AP3 AP4 AP5
           AN1 AN2 AN3 AN4 AN5
           S1 S2 S3 S4 S5
           (GROUPMEAN);

  ANALYSIS:
    TYPE = COMPLEX;
    ESTIMATOR = MLR;
    STARTS = 100;
    ITERATIONS = 10000;

  MODEL:
    ! Parameter labels in the overall block impose equality across groups.
    ! Each labelled loading is on its own BY statement to satisfy Mplus syntax.
    AP BY AP1@1;
    AP BY AP2 (lpa2);
    AP BY AP3 (lpa3);
    AP BY AP4 (lpa4);
    AP BY AP5 (lpa5);

    AN BY AN1@1;
    AN BY AN2 (lna2);
    AN BY AN3 (lna3);
    AN BY AN4 (lna4);
    AN BY AN5 (lna5);

    ST BY S1@1;
    ST BY S2 (lst2);
    ST BY S3 (lst3);
    ST BY S4 (lst4);
    ST BY S5 (lst5);

  MODEL online:
    AN BY AP2 (oxpa);
    AP BY AN2 (oxan);
    [AP1@0 AP2@0 AP3@0 AP4@0 AP5@0];
    [AN1@0 AN2@0 AN3@0 AN4@0 AN5@0];
    [S1@0 S2@0 S3@0 S4@0 S5@0];
    [AP@0 AN@0 ST@0];
    AP AN ST;
    AP1-AP5*;
    AN1-AN5*;
    S1-S5*;
    AP WITH AN (opan);
    AP WITH ST (opst);
    AN WITH ST (onst);

  MODEL f2f:
    AN BY AP2 (fxpa);
    AP BY AN2 (fxan);
    [AP1@0 AP2@0 AP3@0 AP4@0 AP5@0];
    [AN1@0 AN2@0 AN3@0 AN4@0 AN5@0];
    [S1@0 S2@0 S3@0 S4@0 S5@0];
    [AP@0 AN@0 ST@0];
    AP AN ST;
    AP1-AP5*;
    AN1-AN5*;
    S1-S5*;
    AP WITH AN (fpan);
    AP WITH ST (fpst);
    AN WITH ST (fnst);

  OUTPUT:
    SAMPSTAT STANDARDIZED CINTERVAL RESIDUAL TECH1 TECH4 MODINDICES(10);



INPUT READING TERMINATED NORMALLY




