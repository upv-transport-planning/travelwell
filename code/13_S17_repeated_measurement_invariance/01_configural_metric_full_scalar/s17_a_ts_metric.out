    STcc BY S5cc (ls5);

    STsc BY S1sc@1;
    STsc BY S2sc (ls2);
    STsc BY S3sc (ls3);
    STsc BY S4sc (ls4);
    STsc BY S5sc (ls5);

    STct BY S1ct@1;
    STct BY S2ct (ls2);
    STct BY S3ct (ls3);
    STct BY S4ct (ls4);
    STct BY S5ct (ls5);

    STst BY S1st@1;
    STst BY S2st (ls2);
    STst BY S3st (ls3);
    STst BY S4st (ls4);
    STst BY S5st (ls5);

    ! Same-indicator residuals correlated across all repeated evaluations.
    S1cc WITH S1sc S1ct S1st;
    S1sc WITH S1ct S1st;
    S1ct WITH S1st;
    S2cc WITH S2sc S2ct S2st;
    S2sc WITH S2ct S2st;
    S2ct WITH S2st;
    S3cc WITH S3sc S3ct S3st;
    S3sc WITH S3ct S3st;
    S3ct WITH S3st;
