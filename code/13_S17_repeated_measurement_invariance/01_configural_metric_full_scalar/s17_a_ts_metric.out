    ;
    USEVARIABLES =
    S1cc S2cc S3cc S4cc S5cc S1sc S2sc
    S3sc S4sc S5sc S1ct S2ct S3ct S4ct
    S5ct S1st S2st S3st S4st S5st
    ;
    MISSING = ALL(-999);

  ANALYSIS:
