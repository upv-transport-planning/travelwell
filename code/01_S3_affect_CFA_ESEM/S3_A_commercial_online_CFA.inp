TITLE: PANAS Comercios - CFA Online;

DATA:
FILE = ../../data/datos_com_terr_legacy_order.txt;

VARIABLE:
NAMES =
id MODO online
ap1cc ap1sc an1cc an1sc
ap2cc ap2sc an2cc an2sc
ap3cc ap3sc an3cc an3sc
ap4cc ap4sc an4cc an4sc
ap5cc ap5sc an5cc an5sc
S1cc S1sc S2cc S2sc S3cc S3sc S4cc S4sc S5cc S5sc
ap1ct ap1st an1ct an1st
ap2ct ap2st an2ct an2st
ap3ct ap3st an3ct an3st
ap4ct ap4st an4ct an4st
ap5ct ap5st an5ct an5st
S1ct S1st S2ct S2st S3ct S3st S4ct S4st S5ct S5st
V1 V2 V3 V4 V5 V6 V7 V8 V9
V10 V11 V12 V13 V14 V15 V16
V17 V18 V19;

USEVARIABLES =
ap1cc ap2cc ap3cc ap4cc ap5cc
ap1sc ap2sc ap3sc ap4sc ap5sc
an1cc an2cc an3cc an4cc an5cc
an1sc an2sc an3sc an4sc an5sc;

USEOBSERVATIONS = online EQ 1;

MISSING = ALL (-999);

ANALYSIS:
ESTIMATOR = MLR;

MODEL:

APcc BY ap1cc ap2cc ap3cc ap4cc ap5cc;
APsc BY ap1sc ap2sc ap3sc ap4sc ap5sc;
ANcc BY an1cc an2cc an3cc an4cc an5cc;
ANsc BY an1sc an2sc an3sc an4sc an5sc;

APcc WITH ANcc;
APsc WITH ANsc;
APcc WITH APsc;
ANcc WITH ANsc;

ap1cc WITH ap1sc;
ap2cc WITH ap2sc;
ap3cc WITH ap3sc;
ap4cc WITH ap4sc;
ap5cc WITH ap5sc;

an1cc WITH an1sc;
an2cc WITH an2sc;
an3cc WITH an3sc;
an4cc WITH an4sc;
an5cc WITH an5sc;

OUTPUT:
STANDARDIZED;
MODINDICES(10);
SAMPSTAT;
RESIDUAL;
TECH1;
TECH4;
