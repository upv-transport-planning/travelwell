Mplus VERSION 9.1
MUTHEN & MUTHEN
08/08/2026   7:32 PM

INPUT INSTRUCTIONS

  TITLE:
  SCENARIO A - TRAVEL FREQUENCY - BINARY RECODING
  STRUCTURAL FREE + WALD: NON-DAILY VS DAILY
  COMMERCIAL ACTIVITY AND TERRACES
  TYPE=COMPLEX, MLR, CLUSTER=ID, STARTS=100;

  DATA:
  FILE = datos_com_terr_formato_largo.txt;

  VARIABLE:

  NAMES =
  ID
  MODO_rango
  online
  block
  present
  AP1 AP2 AP3 AP4 AP5
  AN1 AN2 AN3 AN4 AN5
  S1 S2 S3 S4 S5
  V1 V2 V3 V4 V5
  V6 V7 V8 V9 V10
  V11 V12 V13 V14 V15
  V16 V17 V18 V19;

  USEVARIABLES =
  ID
  online
  block
  present
  AP1 AP2 AP3 AP4 AP5
  AN1 AN2 AN3 AN4 AN5
  S1 S2 S3 S4 S5
  pblock
  freq2;

  CLUSTER = ID;

  ! Recodificacion:
  ! freq2=1: no diario (V14=1 o 2; 1-2 o 3-4 dias/semana).
  ! freq2=2: diario (V14=3; todos los dias).
  GROUPING = freq2 (1 = nondaily 2 = daily);

  MISSING = ALL(-999);

  DEFINE:
  ! Survey method: online=1, face-to-face=2.
  pblock = present*block;

  ! Crear la variable de agrupacion binaria a partir de V14.
  freq2 = V14;
  IF (V14 EQ 1) THEN freq2 = 1;
  IF (V14 EQ 2) THEN freq2 = 1;
  IF (V14 EQ 3) THEN freq2 = 2;

  ANALYSIS:
  TYPE = COMPLEX;
  ESTIMATOR = MLR;
  STARTS = 100;
  ITERATIONS = 10000;


  MODEL:

  ! Grupo de referencia: no diario.
  AP BY
  AP1@1
  AP2 (lpa2)
  AP3 (lpa3)
  AP4 (lpa4)
  AP5 (lpa5);

  AN BY
  AN1@1
  AN2 (lna2)
  AN3 (lna3)
  AN4 (lna4)
  AN5 (lna5);

  ST BY
  S1@1
  S2 (lst2)
  S3 (lst3)
  S4 (lst4)
  S5 (lst5);

  ! Las dos cross-loadings del modelo global se conservan
  ! y permanecen libres entre grupos.
  AN BY AP2 (ndxpa);
  AP BY AN2 (ndxan);

  ! Interceptos de items libres: no se impone invariancia escalar.
  [AP1-AP5*];
  [AN1-AN5*];
  [S1-S5*];

  ! Interceptos latentes fijados a cero con interceptos de items libres.
  [AP@0];
  [AN@0];
  [ST@0];

  ! Varianzas latentes y residuos de items libres por grupo.
  AP AN ST;
  AP1-AP5*;
  AN1-AN5*;
  S1-S5*;

  ! Covarianza AP-AN libre por grupo.
  AP WITH AN (ndpan);

  AP ON
  present (nda1)
  block   (nda2)
  pblock  (nda3)
  online  (nda4);

  AN ON
  present (ndd1)
  block   (ndd2)
  pblock  (ndd3)
  online  (ndd4);

  ST ON
  AP      (ndb1)
  AN      (ndb2)
  present (ndc1)
  block   (ndc2)
  pblock  (ndc3)
  online  (ndc4);

  MODEL daily:

  AP BY
  AP1@1
  AP2 (lpa2)
  AP3 (lpa3)
  AP4 (lpa4)
  AP5 (lpa5);

  AN BY
  AN1@1
  AN2 (lna2)
  AN3 (lna3)
  AN4 (lna4)
  AN5 (lna5);

  ST BY
  S1@1
  S2 (lst2)
  S3 (lst3)
  S4 (lst4)
  S5 (lst5);

  ! Las dos cross-loadings del modelo global se conservan
  ! y permanecen libres entre grupos.
  AN BY AP2 (dyxpa);
  AP BY AN2 (dyxan);

  ! Interceptos de items libres: no se impone invariancia escalar.
  [AP1-AP5*];
  [AN1-AN5*];
  [S1-S5*];

  ! Interceptos latentes fijados a cero con interceptos de items libres.
  [AP@0];
  [AN@0];
  [ST@0];

  ! Varianzas latentes y residuos de items libres por grupo.
  AP AN ST;
  AP1-AP5*;
  AN1-AN5*;
  S1-S5*;

  ! Covarianza AP-AN libre por grupo.
  AP WITH AN (dypan);

  AP ON
  present (dya1)
  block   (dya2)
  pblock  (dya3)
  online  (dya4);

  AN ON
  present (dyd1)
  block   (dyd2)
  pblock  (dyd3)
  online  (dyd4);

  ST ON
  AP      (dyb1)
  AN      (dyb2)
  present (dyc1)
  block   (dyc2)
  pblock  (dyc3)
  online  (dyc4);


  MODEL CONSTRAINT:

  NEW(
  ndcdr ndcip ndcin ndcii ndcto
  ndtdr ndtip ndtin ndtii ndtto
  dycdr dycip dycin dycii dycto
  dytdr dytip dytin dytii dytto
  dcdr dcip dcin dcii dcto
  dtdr dtip dtin dtii dtto
  );

  ! ==================================================
  ! NO DIARIO
  ! ==================================================

  ! Actividad comercial: block=0.
  ndcdr = ndc1;
  ndcip = nda1*ndb1;
  ndcin = ndd1*ndb2;
  ndcii = ndcip+ndcin;
  ndcto = ndcdr+ndcii;

  ! Terrazas: block=1.
  ndtdr = ndc1+ndc3;
  ndtip = (nda1+nda3)*ndb1;
  ndtin = (ndd1+ndd3)*ndb2;
  ndtii = ndtip+ndtin;
  ndtto = ndtdr+ndtii;

  ! ==================================================
  ! DIARIO
  ! ==================================================

  ! Actividad comercial: block=0.
  dycdr = dyc1;
  dycip = dya1*dyb1;
  dycin = dyd1*dyb2;
  dycii = dycip+dycin;
  dycto = dycdr+dycii;

  ! Terrazas: block=1.
  dytdr = dyc1+dyc3;
  dytip = (dya1+dya3)*dyb1;
  dytin = (dyd1+dyd3)*dyb2;
  dytii = dytip+dytin;
  dytto = dytdr+dytii;

  ! ==================================================
  ! DIFERENCIAS: DIARIO MENOS NO DIARIO
  ! ==================================================

  ! Actividad comercial.
  dcdr = dycdr-ndcdr;
  dcip = dycip-ndcip;
  dcin = dycin-ndcin;
  dcii = dycii-ndcii;
  dcto = dycto-ndcto;

  ! Terrazas.
  dtdr = dytdr-ndtdr;
  dtip = dytip-ndtip;
  dtin = dytin-ndtin;
  dtii = dytii-ndtii;
  dtto = dytto-ndtto;


  MODEL TEST:

  ! Wald global de igualdad de los 11 caminos estructurales
  ! entre usuarios diarios y no diarios.
  ! Los coeficientes de online son covariables de ajuste y no se contrastan.

  0 = dya1-nda1;
  0 = dya2-nda2;
  0 = dya3-nda3;

  0 = dyd1-ndd1;
  0 = dyd2-ndd2;
  0 = dyd3-ndd3;

  0 = dyb1-ndb1;
  0 = dyb2-ndb2;

  0 = dyc1-ndc1;
  0 = dyc2-ndc2;
  0 = dyc3-ndc3;


  OUTPUT:
  SAMPSTAT;
  STANDARDIZED;
  CINTERVAL;
  RESIDUAL;
  TECH1;
  TECH4;




INPUT READING TERMINATED NORMALLY




