TITLE:
  MULTILEVEL SENSITIVITY - ICC DIAGNOSTICS - SCENARIO B
  urban greenery: street-tree presence and tree size.
  TYPE=TWOLEVEL BASIC reports within/between sample statistics and ICCs.

DATA:
  FILE = ../../data/Scenario_B_long_final.txt;

VARIABLE:
  NAMES =
  ID MODO_rango online block present AP1 AP2
  AP3 AP4 AP5 AN1 AN2 AN3 AN4
  AN5 S1 S2 S3 S4 S5 V1
  V2 V3 V4 V5 V6 V7 V8
  V9 V10 V11 V12 V13 V14 V15
  V16 V17 V18 V19
  ;
  USEVARIABLES =
  AP1 AP2 AP3 AP4 AP5
  AN1 AN2 AN3 AN4 AN5
  S1 S2 S3 S4 S5;
  CLUSTER = ID;
  MISSING = ALL(-999);

ANALYSIS:
  TYPE = TWOLEVEL BASIC;
  ESTIMATOR = MLR;

OUTPUT:
  SAMPSTAT;
