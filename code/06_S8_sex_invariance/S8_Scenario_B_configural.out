Mplus VERSION 9.1
MUTHEN & MUTHEN
08/08/2026  12:28 PM

INPUT INSTRUCTIONS

  TITLE:
  SCENARIO B - SEX - CONFIGURAL
  TREE PRESENCE AND TREE SIZE
  TYPE=COMPLEX, MLR, CLUSTER=ID, STARTS=100;

  DATA:
  FILE = datos_arboles_formato_largo.txt;

  VARIABLE:

  NAMES =
  ID
  MODO_rango
  online
  block
  present
  AP1 AP2 AP3 AP4 AP5
  AN1 AN2 AN3 AN4 AN5
  S1 S2 S3 S4 S5
  V1 V2 V3 V4 V5
  V6 V7 V8 V9 V10
  V11 V12 V13 V14 V15
  V16 V17 V18 V19;

  USEVARIABLES =
  ID
  online
  block
  present
  AP1 AP2 AP3 AP4 AP5
  AN1 AN2 AN3 AN4 AN5
  S1 S2 S3 S4 S5
  pblock;

  CLUSTER = ID;

  GROUPING = V3 (1 = woman 2 = man);
  ! V3=1: mujer; V3=2: hombre.

  MISSING = ALL(-999);

  DEFINE:
  ! Survey method: online=1, face-to-face=2.
  pblock = present*block;

  ANALYSIS:
  TYPE = COMPLEX;
  ESTIMATOR = MLR;
  STARTS = 100;
  ITERATIONS = 10000;

  MODEL:

  ! Reference group = category 1.
  AP BY
  AP1@1
  AP2 (wpa2)
  AP3 (wpa3)
  AP4 (wpa4)
  AP5 (wpa5);

  AN BY
  AN1@1
  AN2 (wna2)
  AN3 (wna3)
  AN4 (wna4)
  AN5 (wna5);

  ST BY
  S1@1
  S2 (wst2)
  S3 (wst3)
  S4 (wst4)
  S5 (wst5);

  ! Cross-loadings kept free across groups.
  AN BY AP2 (wxpa);
  AP BY AN2 (wxan);

  ! Item intercepts free: scalar invariance is not imposed.
  [AP1-AP5*];
  [AN1-AN5*];
  [S1-S5*];

  ! Latent intercepts fixed to zero when item intercepts are free.
  [AP@0];
  [AN@0];
  [ST@0];

  ! Latent variances and item residual variances free by group.
  AP AN ST;
  AP1-AP5*;
  AN1-AN5*;
  S1-S5*;

  AP WITH AN (wpan);

  AP ON
  present (wa1)
  block   (wa2)
  pblock  (wa3)
  online  (wa4);

  AN ON
  present (wd1)
  block   (wd2)
  pblock  (wd3)
  online  (wd4);

  ST ON
  AP      (wb1)
  AN      (wb2)
  present (wc1)
  block   (wc2)
  pblock  (wc3)
  online  (wc4);

  MODEL man:

  AP BY
  AP1@1
  AP2 (mpa2)
  AP3 (mpa3)
  AP4 (mpa4)
  AP5 (mpa5);

  AN BY
  AN1@1
  AN2 (mna2)
  AN3 (mna3)
  AN4 (mna4)
  AN5 (mna5);

  ST BY
  S1@1
  S2 (mst2)
  S3 (mst3)
  S4 (mst4)
  S5 (mst5);

  ! Cross-loadings kept free across groups.
  AN BY AP2 (mxpa);
  AP BY AN2 (mxan);

  ! Item intercepts free: scalar invariance is not imposed.
  [AP1-AP5*];
  [AN1-AN5*];
  [S1-S5*];

  ! Latent intercepts fixed to zero when item intercepts are free.
  [AP@0];
  [AN@0];
  [ST@0];

  ! Latent variances and item residual variances free by group.
  AP AN ST;
  AP1-AP5*;
  AN1-AN5*;
  S1-S5*;

  AP WITH AN (mpan);

  AP ON
  present (ma1)
  block   (ma2)
  pblock  (ma3)
  online  (ma4);

  AN ON
  present (md1)
  block   (md2)
  pblock  (md3)
  online  (md4);

  ST ON
  AP      (mb1)
  AN      (mb2)
  present (mc1)
  block   (mc2)
  pblock  (mc3)
  online  (mc4);

  OUTPUT:
  SAMPSTAT;
  STANDARDIZED;
  CINTERVAL;
  RESIDUAL;
  TECH1;
  TECH4;
  MODINDICES(10);



INPUT READING TERMINATED NORMALLY




