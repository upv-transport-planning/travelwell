TITLE: PANAS Terrazas - Esem multigrupo;

DATA:
FILE = ../../data/datos_com_terr_legacy_order.txt;

VARIABLE:
NAMES =
id MODO online
ap1cc ap1sc an1cc an1sc
ap2cc ap2sc an2cc an2sc
ap3cc ap3sc an3cc an3sc
ap4cc ap4sc an4cc an4sc
ap5cc ap5sc an5cc an5sc
S1cc S1sc S2cc S2sc S3cc
S3sc S4cc S4sc S5cc S5sc
ap1ct ap1st an1ct an1st
ap2ct ap2st an2ct an2st
ap3ct ap3st an3ct an3st
ap4ct ap4st an4ct an4st
ap5ct ap5st an5ct an5st
S1ct S1st S2ct S2st S3ct
S3st S4ct S4st S5ct S5st
V1 V2 V3 V4 V5 V6 V7 V8 V9
V10 V11 V12 V13 V14 V15 V16
V17 V18 V19;

USEVARIABLES =
ap1ct ap2ct ap3ct ap4ct ap5ct
ap1st ap2st ap3st ap4st ap5st
an1ct an2ct an3ct an4ct an5ct
an1st an2st an3st an4st an5st;

GROUPING = online
(1 = online
 2 = presencial);

MISSING = ALL (-999);

ANALYSIS:
ESTIMATOR = MLR;
ROTATION = TARGET;

MODEL:

APct BY ap1ct ap2ct ap3ct ap4ct ap5ct
ap1st~0 ap2st~0 ap3st~0 ap4st~0 ap5st~0
an1ct~0 an2ct~0 an3ct~0 an4ct~0 an5ct~0
an1st~0 an2st~0 an3st~0 an4st~0 an5st~0 (*1);

APst BY ap1st ap2st ap3st ap4st ap5st
ap1ct~0 ap2ct~0 ap3ct~0 ap4ct~0 ap5ct~0
an1ct~0 an2ct~0 an3ct~0 an4ct~0 an5ct~0
an1st~0 an2st~0 an3st~0 an4st~0 an5st~0 (*1);

ANct BY an1ct an2ct an3ct an4ct an5ct
ap1ct~0 ap2ct~0 ap3ct~0 ap4ct~0 ap5ct~0
ap1st~0 ap2st~0 ap3st~0 ap4st~0 ap5st~0
an1st~0 an2st~0 an3st~0 an4st~0 an5st~0 (*1);

ANst BY an1st an2st an3st an4st an5st
ap1ct~0 ap2ct~0 ap3ct~0 ap4ct~0 ap5ct~0
ap1st~0 ap2st~0 ap3st~0 ap4st~0 ap5st~0
an1ct~0 an2ct~0 an3ct~0 an4ct~0 an5ct~0 (*1);

APct WITH ANct;
APst WITH ANst;
APct WITH APst;
ANct WITH ANst;

ap1ct WITH ap1st;
ap2ct WITH ap2st;
ap3ct WITH ap3st;
ap4ct WITH ap4st;
ap5ct WITH ap5st;

an1ct WITH an1st;
an2ct WITH an2st;
an3ct WITH an3st;
an4ct WITH an4st;
an5ct WITH an5st;

OUTPUT:
STANDARDIZED;
MODINDICES(10);
SAMPSTAT;
RESIDUAL;
TECH1;
TECH4;
