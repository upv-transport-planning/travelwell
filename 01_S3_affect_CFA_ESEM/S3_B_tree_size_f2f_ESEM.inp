TITLE: SD rbolesPG - ESEM APN Presencial;

  DATA:
  FILE = ../../data/datos_arb_legacy_order.txt;

  VARIABLE:
  NAMES =
  id MODO online
  AP1ca	AP1sa	AN1ca	AN1sa	
  AP2ca	AP2sa	AN2ca	AN2sa	
  AP3ca	AP3sa	AN3ca	AN3sa	
  AP4ca	AP4sa	AN4ca	AN4sa	
  AP5ca	AP5sa	AN5ca	AN5sa	
  SD1ca	SD1sa	SD2ca	SD2sa	SD3ca	SD3sa	SD4ca	SD4sa	SD5ca	SD5sa	
  AP1ap	AP1ag	AN1ap	AN1ag
  AP2ap	AP2ag	AN2ap	AN2ag	
  AP3ap	AP3ag	AN3ap	AN3ag	
  AP4ap	AP4ag	AN4ap	AN4ag	
  AP5ap	AP5ag	AN5ap	AN5ag	
  SD1ap	SD1ag	SD2ap	SD2ag	SD3ap	SD3ag	SD4ap	SD4ag	SD5ap	SD5ag	
  V1	V2	V3	V4	V5	V6	V7	V8	V9	V10	V11	V12	V13	V14	V15	V16	V17	V18	V19;

  USEVARIABLES =
  AP1ap	AP1ag	AN1ap	AN1ag
  AP2ap	AP2ag	AN2ap	AN2ag	
  AP3ap	AP3ag	AN3ap	AN3ag	
  AP4ap	AP4ag	AN4ap	AN4ag	
  AP5ap	AP5ag	AN5ap	AN5ag	;

USEOBSERVATIONS = online EQ 2;

  MISSING = ALL (-999);

  ANALYSIS:
  ESTIMATOR = MLR;
  ROTATION = TARGET;

  MODEL:

APap BY ap1ap ap2ap ap3ap ap4ap ap5ap
ap1ag~0 ap2ag~0 ap3ag~0 ap4ag~0 ap5ag~0
an1ap~0 an2ap~0 an3ap~0 an4ap~0 an5ap~0
an1ag~0 an2ag~0 an3ag~0 an4ag~0 an5ag~0 (*1);

APag BY ap1ag ap2ag ap3ag ap4ag ap5ag
ap1ap~0 ap2ap~0 ap3ap~0 ap4ap~0 ap5ap~0
an1ap~0 an2ap~0 an3ap~0 an4ap~0 an5ap~0
an1ag~0 an2ag~0 an3ag~0 an4ag~0 an5ag~0 (*1);

ANap BY an1ap an2ap an3ap an4ap an5ap
ap1ap~0 ap2ap~0 ap3ap~0 ap4ap~0 ap5ap~0
ap1ag~0 ap2ag~0 ap3ag~0 ap4ag~0 ap5ag~0
an1ag~0 an2ag~0 an3ag~0 an4ag~0 an5ag~0 (*1);

ANag BY an1ag an2ag an3ag an4ag an5ag
ap1ap~0 ap2ap~0 ap3ap~0 ap4ap~0 ap5ap~0
ap1ag~0 ap2ag~0 ap3ag~0 ap4ag~0 ap5ag~0
an1ap~0 an2ap~0 an3ap~0 an4ap~0 an5ap~0 (*1);

  APap WITH ANap;
  APag WITH ANag;
  APap WITH APag;
  ANap WITH ANag;

  ap1ap WITH ap1ag;
  ap2ap WITH ap2ag;
  ap3ap WITH ap3ag;
  ap4ap WITH ap4ag;
  ap5ap WITH ap5ag;

  an1ap WITH an1ag;
  an2ap WITH an2ag;
  an3ap WITH an3ag;
  an4ap WITH an4ag;
  an5ap WITH an5ag;

  OUTPUT:
  STANDARDIZED;
  MODINDICES(10);
  SAMPSTAT;
  RESIDUAL;
  TECH1;
  TECH4;
